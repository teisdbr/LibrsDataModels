<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageVersion>1.0.29</PackageVersion>
        <Title>LibrsDataModels</Title>
        <Authors>Technology Engineers, Inc.</Authors>
        <Description>Contains C# Objects for LIBRS State Reporting. </Description>
    </PropertyGroup>

    <!-- Conditionally bring in references for the .NET Standard 2.0 target -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
	    <PackageReference Include="MongoDB.Driver" Version="2.10.2" />
        <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
        <PackageReference Include="NibrsDataModels" Version="1.3.12" />
    </ItemGroup>

	<!-- Conditionally bring in references for the .NET 8.0 target -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="MongoDB.Driver" Version="3.4.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NibrsModels" Version="1.3.13" />
    </ItemGroup>
</Project>
